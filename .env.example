# Copy to .env:  cp .env.example .env
# Safe local-development defaults. Never commit .env.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-anything-but-local-dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# standard = Celery + Redis; single = in-process worker, no Redis (hosted demo)
DEPLOY_MODE=standard
EVENT_BUS=celery

# Set by docker-compose for containers; used when running Django directly on the host.
DATABASE_URL=postgres://faultkeeper:faultkeeper@localhost:5432/faultkeeper
REDIS_URL=redis://localhost:6379/0

# Issue Insights (story 9.0)
INSIGHTS_PROVIDER=ollama
INSIGHTS_MODEL=
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=

EVENT_RETENTION_DAYS=30
INGEST_MAX_BYTES=1048576
LOG_LEVEL=INFO
